# Server-side only. These are read by the /api/chat backend and are never
# bundled into the browser.

# OpenAI API key. Leave it unset to run in demo mode (quests work fully; chat
# answers with built-in worked examples).
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-goes-here

# Optional: model name (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Optional: use the Python intent service instead of the built-in rules
# VITE_INTENT_SERVICE_URL=http://localhost:8000/classify
